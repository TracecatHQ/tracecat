  */
-[[nodiscard]] pid_t cloneProc(uint64_t flags, int exit_signal, int* pidfd) {
+[[nodiscard]] pid_t cloneProc(uint64_t flags, int exit_signal, int* pidfd, int cgroup_fd) {
 	exit_signal &= CSIGNAL;
 
 	if (flags & CLONE_VM) {
@@ -581,10 +591,15 @@ pid_t runChild(
 	ca.exit_signal = (uint64_t)exit_signal;
 	ca.flags = flags | CLONE_PIDFD | CLONE_CLEAR_SIGHAND;
 	ca.pidfd = (uint64_t)pidfd;
+	if (cgroup_fd >= 0) {
+		ca.flags |= CLONE_INTO_CGROUP;
+		ca.cgroup = (uint64_t)cgroup_fd;
+	}
 
 	pid_t ret = util::syscall(__NR_clone3, (uintptr_t)&ca, sizeof(ca));
 	if (ret == -1) {
-		PLOG_W("clone3(flags=%s|CLONE_PIDFD) failed", cloneFlagsToStr(flags).c_str());
+		PLOG_W("clone3(flags=%s|CLONE_PIDFD%s) failed", cloneFlagsToStr(flags).c_str(),
+		    cgroup_fd >= 0 ? "|CLONE_INTO_CGROUP" : "");
 		return -1;
 	}
 	return ret;
