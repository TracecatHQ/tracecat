+	}
 	if (pid == -1) {
 		auto saved_errno = errno;
 		PLOG_W("clone(flags=%s) failed", cloneFlagsToStr(flags).c_str());
@@ -563,7 +573,7 @@ pid_t runChild(
  * Returns child pid in the parent, 0 in the child, -1 on error.
