+int prepareCloneInto(nsj_t* nsj);
+void finishCloneInto(nsj_t* nsj, int cgroup_fd, pid_t pid);
+void abortCloneInto(nsj_t* nsj, int cgroup_fd);
 
 }  // namespace cgroup2
 
