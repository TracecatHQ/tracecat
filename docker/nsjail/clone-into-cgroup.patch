diff --git a/cgroup2.cc b/cgroup2.cc
index f2619bb..07efb9b 100644
--- a/cgroup2.cc
+++ b/cgroup2.cc
@@ -22,6 +22,7 @@
 #include "cgroup2.h"
 
 #include <errno.h>
+#include <sched.h>
 #include <fcntl.h>
 #include <limits.h>
 #include <linux/magic.h>
@@ -32,11 +33,23 @@
 #include <sys/vfs.h>
 #include <unistd.h>
 
+#include <map>
+
 #include "logs.h"
 #include "util.h"
 
 namespace cgroup2 {
 
+/*
+ * Cgroups of children created directly inside them with CLONE_INTO_CGROUP, by
+ * pid. Writing a pid to cgroup.procs takes cgroup_threadgroup_rwsem for writing,
+ * which waits for an RCU grace period (tens of ms on busy hosts); cloning into
+ * the cgroup avoids the move entirely. The cgroup is created before the pid is
+ * known and cgroup v2 forbids renames, so it keeps its creation-time name.
+ */
+static std::map<pid_t, std::string> cloned_into_cgroup;
+static unsigned long clone_into_seq = 0;
+
 static bool addPidToProcList(const std::string& cgroup_path, pid_t pid) {
 	std::string pid_str = std::to_string(pid);
 
@@ -215,6 +228,11 @@ static bool initNsFromParentMem(nsj_t* nsj, pid_t pid) {
 		return true;
 	}
 
+	if (cloned_into_cgroup.count(pid)) {
+		/* Created with its limits by prepareCloneInto(); nothing to move. */
+		return true;
+	}
+
 	std::string cgroup_path = getCgroupPath(nsj, pid);
 	RETURN_ON_FAILURE(createCgroup(cgroup_path, pid));
 	RETURN_ON_FAILURE(addPidToProcList(cgroup_path, pid));
@@ -268,12 +286,77 @@ bool initNsFromParent(nsj_t* nsj, pid_t pid) {
 }
 
 void finishFromParent(nsj_t* nsj, pid_t pid) {
+	auto cloned = cloned_into_cgroup.find(pid);
+	if (cloned != cloned_into_cgroup.end()) {
+		removeCgroup(cloned->second);
+		cloned_into_cgroup.erase(cloned);
+		return;
+	}
 	if (nsj->njc.cgroup_mem_max() != (size_t)0 || nsj->njc.cgroup_pids_max() != 0U ||
 	    nsj->njc.cgroup_cpu_ms_per_sec() != 0U) {
 		removeCgroup(getCgroupPath(nsj, pid));
 	}
 }
 
+static std::string getCloneIntoCgroupPath(nsj_t* nsj) {
+	return nsj->njc.cgroupv2_mount() + "/NSJAIL." + std::to_string(getpid()) + "." +
+	       std::to_string(clone_into_seq);
+}
+
+/*
+ * Create the child's memory cgroup with its limits before clone3(), and return an
+ * O_PATH directory fd for CLONE_INTO_CGROUP, or -1 to fall back to moving the
+ * child after clone. Only the memory controller takes this path; pids and cpu
+ * limits keep the existing per-controller setup.
+ */
+int prepareCloneInto(nsj_t* nsj) {
+	if (!nsj->njc.use_cgroupv2() || !needMemoryController(nsj) || needPidsController(nsj) ||
+	    needCpuController(nsj)) {
+		return -1;
+	}
+	clone_into_seq++;
+	std::string cgroup_path = getCloneIntoCgroupPath(nsj);
+	if (mkdir(cgroup_path.c_str(), 0700) == -1) {
+		PLOG_W("mkdir('%s', 0700) failed", cgroup_path.c_str());
+		return -1;
+	}
+
+	ssize_t swap_max = nsj->njc.cgroup_mem_swap_max();
+	if (nsj->njc.cgroup_mem_memsw_max() > (size_t)0) {
+		swap_max = nsj->njc.cgroup_mem_memsw_max() - nsj->njc.cgroup_mem_max();
+	}
+	bool ok = true;
+	if (nsj->njc.cgroup_mem_max() > (size_t)0) {
+		ok = writeToCgroup(
+		    cgroup_path, "memory.max", std::to_string(nsj->njc.cgroup_mem_max()));
+	}
+	if (ok && swap_max >= (ssize_t)0) {
+		ok = writeToCgroup(cgroup_path, "memory.swap.max", std::to_string(swap_max));
+	}
+	int fd = ok ? TEMP_FAILURE_RETRY(open(cgroup_path.c_str(), O_PATH | O_DIRECTORY | O_CLOEXEC))
+		    : -1;
+	if (fd == -1) {
+		if (ok) {
+			PLOG_W("open('%s', O_PATH|O_DIRECTORY) failed", cgroup_path.c_str());
+		}
+		removeCgroup(cgroup_path);
+		return -1;
+	}
+	return fd;
+}
+
+/* Record the cgroup a child was cloned into, for initNsFromParent and cleanup. */
+void finishCloneInto(nsj_t* nsj, int cgroup_fd, pid_t pid) {
+	close(cgroup_fd);
+	cloned_into_cgroup[pid] = getCloneIntoCgroupPath(nsj);
+}
+
+/* Discard a prepared cgroup that no child entered. */
+void abortCloneInto(nsj_t* nsj, int cgroup_fd) {
+	close(cgroup_fd);
+	removeCgroup(getCloneIntoCgroupPath(nsj));
+}
+
 bool initUser(nsj_t* nsj) {
 	return true;
 }
