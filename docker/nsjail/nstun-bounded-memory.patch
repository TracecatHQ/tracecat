+[[nodiscard]] inline bool try_reserve_udp_icmp_socket(Context* ctx) {
+	if (ctx->udp_icmp_socket_count >= UDP_ICMP_SOCKET_BUDGET) {
+		return false;
+	}
+	ctx->udp_icmp_socket_count++;
+	return true;
