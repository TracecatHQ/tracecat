-	/* Reuse old allocations if available, otherwise allocate */
-	flow->c_tcp_tx_buf =
-	    old_tx ? std::move(old_tx)
-		   : std::unique_ptr<uint8_t[]>(new (std::nothrow) uint8_t[TCP_TX_BUF_CAP]);
-	flow->c_tcp_rx_buf =
-	    old_rx ? std::move(old_rx)
-		   : std::unique_ptr<uint8_t[]>(new (std::nothrow) uint8_t[TCP_RX_BUF_CAP]);
-	flow->c_proxy_rx_buf =
-	    old_proxy ? std::move(old_proxy)
-		      : std::unique_ptr<uint8_t[]>(new (std::nothrow) uint8_t[PROXY_RX_BUF_CAP]);
-
-	if (!flow->c_tcp_tx_buf || !flow->c_tcp_rx_buf || !flow->c_proxy_rx_buf) {
-		flow->c_tcp_tx_buf.reset();
-		flow->c_tcp_rx_buf.reset();
-		flow->c_proxy_rx_buf.reset();
+	if (ctx->tcp_buffer_bytes > TCP_BUFFER_BUDGET ||
+	    TCP_FLOW_BUFFER_BYTES > TCP_BUFFER_BUDGET - ctx->tcp_buffer_bytes) {
 		return false;
 	}
+
+	auto tx = std::unique_ptr<uint8_t[]>(new (std::nothrow) uint8_t[TCP_TX_BUF_CAP]);
+	auto rx = std::unique_ptr<uint8_t[]>(new (std::nothrow) uint8_t[TCP_RX_BUF_CAP]);
+	auto proxy = std::unique_ptr<uint8_t[]>(new (std::nothrow) uint8_t[PROXY_RX_BUF_CAP]);
+	if (!tx || !rx || !proxy) {
+		return false;
+	}
+
+	flow->c_tcp_tx_buf = std::move(tx);
+	flow->c_tcp_rx_buf = std::move(rx);
+	flow->c_proxy_rx_buf = std::move(proxy);
+	ctx->tcp_buffer_bytes += TCP_FLOW_BUFFER_BYTES;
