+static void release_tcp_flow_buffers(Context* ctx, TcpFlow* flow) {
+	size_t released = 0;
+	if (flow->c_tcp_tx_buf) {
+		released += TCP_TX_BUF_CAP;
+	}
+	if (flow->c_tcp_rx_buf) {
+		released += TCP_RX_BUF_CAP;
+	}
+	if (flow->c_proxy_rx_buf) {
+		released += PROXY_RX_BUF_CAP;
+	}
+
+	flow->c_tcp_tx_buf.reset();
+	flow->c_tcp_rx_buf.reset();
+	flow->c_proxy_rx_buf.reset();
+
+	if (released > ctx->tcp_buffer_bytes) {
+		LOG_E("TCP buffer accounting underflow: released=%zu tracked=%zu", released,
+		    ctx->tcp_buffer_bytes);
+		ctx->tcp_buffer_bytes = TCP_BUFFER_BUDGET;
+		return;
+	}
+	ctx->tcp_buffer_bytes -= released;
+}
+
 void tcp_destroy_flow(Context* ctx, TcpFlow* flow) {
 	if (!flow->header.active) {
 		return;
