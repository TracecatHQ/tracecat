-	/* Zero all POD fields and reset unique_ptrs */
+[[nodiscard]] static bool init_tcp_flow_zero(Context* ctx, TcpFlow* flow) {
+	/* Destroyed flows release their buffers instead of retaining attacker-driven
+	 * allocations in the parent process. */
 	*flow = TcpFlow{};
